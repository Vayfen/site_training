# RunAI Configuration - Version Locale (No Cloud Costs!)

# Security
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Local AI Configuration (Ollama)
# No API keys needed! Everything runs on your PC
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Maps Configuration (Optional - for enhanced route features)
MAPBOX_TOKEN=your-mapbox-token-here

# CORS Settings
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Application Settings
ENVIRONMENT=development
DEBUG=true

# Frontend Environment Variables
VITE_API_URL=http://localhost:8000
VITE_MAPBOX_TOKEN=your-mapbox-token-here

# Note: Database is automatically created in your user data directory
# Windows: %APPDATA%\RunAI\runai.db
# Linux/Mac: ~/.runai/runai.db
